{
  "name": "vaani",
  "version": "0.1.0",
  "private": true,
  "description": "Localization workspace for comic, animation and dubbing scripts. Sarvam AI translation with translation memory.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/worker.ts",
    "seed": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed.ts",
    "create:testuser": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/create-test-user.ts",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "check:sarvam": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/check-sarvam.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.47.10",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4"
  }
}
