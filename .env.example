# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Safe to expose to the browser (anon key is gated by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses RLS - never prefix with NEXT_PUBLIC_, never import
# into a client component. Used by the translation worker.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Sarvam AI  (SERVER ONLY)
# ---------------------------------------------------------------------------
SARVAM_API_KEY=
SARVAM_API_BASE_URL=https://api.sarvam.ai

# sarvam-translate:v1 covers English + all 22 scheduled Indian languages.
# mayura:v1 covers 12 languages but adds colloquial/code-mixed modes and
# transliteration (output_script).
SARVAM_MODEL=sarvam-translate:v1

# scene: translate runs of ~40 lines at once with Sarvam's chat model, so
# character gender, tone and idioms come out right; lines it cannot settle
# fall back to SARVAM_MODEL one by one. line: SARVAM_MODEL only (faster,
# cheaper, but blind to context - "He smiles" can come back feminine).
TRANSLATION_ENGINE=scene
SARVAM_CHAT_MODEL=sarvam-105b

# ---------------------------------------------------------------------------
# Worker / queue tuning
# ---------------------------------------------------------------------------
# Concurrent in-flight Sarvam requests. /translate accepts one input per call,
# so throughput is a function of this number. Raise it to match your plan's
# rate limit; back off if you start seeing 429s.
TRANSLATION_CONCURRENCY=8

# Script rows claimed per worker tick.
TRANSLATION_BATCH_SIZE=100

# Attempts per row before it is parked as `failed` for manual review.
TRANSLATION_MAX_ATTEMPTS=3

# Shared secret for POST /api/worker/tick so only your cron can drive the queue.
WORKER_TICK_SECRET=change-me
